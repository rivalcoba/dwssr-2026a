{
  "name": "dwssr-2026a",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "NODE_ENV=production node ./server/bin/www",
    "dev": "DEBUG=dwssr-2026a:server nodemon ./server/bin/www",
    "dev:vite": "vite --host",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:vite\"",
    "build": "vite build",
    "preview": "npm run build && npm run start",
    "lint": "npm run lint:back && npm run lint:front",
    "lint:back": "eslint \"server/**/*.{js,mjs}\"",
    "lint:front": "eslint \"src/**/*.{js,mjs}\"",
    "lint:fix": "eslint . --fix",
    "clean:logs": "rm -rf ./server/logs/*.log"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "^5.2.1",
    "express-handlebars": "^8.0.6",
    "hbs": "^4.2.0",
    "http-errors": "~1.6.3",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.0",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.19",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "vite": "^7.3.1"
  },
  "imports": {
